#!/usr/bin/env bash
#
# bin/iadd-prove — repeated-addition (v0.3-iadd) Stwo runner (KB-15, #127).
#
# Same orchestration as bin/apples-prove (Cairo 1 → simple bootloader →
# Stwo Circle STARK, proved + inline-verified), but for the v0.3-iadd
# fixtures: the Cairo task is `grover_tax_iadd_executable`, which loops the
# stored single-repetition adder `repetitions` times per test case over a
# 512-bit state (`stwo-side/cairo/src/wide.cairo`).
#
# Usage:
#   bin/iadd-prove [--fixture fixtures/v0.3-iadd256-k4-n16.json] \
#                  [--proof-out results/iadd.proof.bin] \
#                  [--proof-format cairo-serde|json|binary]
#
# Exit codes:
#   0  proved + verified
#   1  prove/verify failed
#   2  precondition violated (missing tool, bad fixture)

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd -- "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"

FIXTURE="${REPO_ROOT}/fixtures/v0.3-iadd256-k4-n16.json"
PROOF_OUT="${REPO_ROOT}/results/iadd.proof.bin"
PROOF_FORMAT="json"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --fixture) FIXTURE="$2"; shift 2;;
    --proof-out) PROOF_OUT="$2"; shift 2;;
    --proof-format) PROOF_FORMAT="$2"; shift 2;;
    # RFC-0007 wrapper aliases (symmetry with the SP1 prover CLI).
    --fixtures) FIXTURE="$2"; shift 2;;
    --output) PROOF_OUT="$2"; shift 2;;
    -h|--help)
      sed -n '2,20p' "$0"; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 2;;
  esac
done

# -- preconditions ---------------------------------------------------------

PROVING_UTILS_BIN="${REPO_ROOT}/third_party/proving-utils/target/release/stwo-run-and-prove"
EXECUTABLE_JSON="${REPO_ROOT}/stwo-side/cairo/target/dev/grover_tax_iadd_executable.executable.json"
SIMPLE_BOOTLOADER="${REPO_ROOT}/third_party/proving-utils/crates/cairo-program-runner-lib/resources/compiled_programs/bootloaders/simple_bootloader_compiled.json"

for f in "$PROVING_UTILS_BIN" "$EXECUTABLE_JSON" "$SIMPLE_BOOTLOADER" "$FIXTURE"; do
  if [[ ! -f "$f" ]]; then
    echo "MEASUREMENT.ENV_VAR_MISS: missing prerequisite: $f" >&2
    if [[ "$f" == "$PROVING_UTILS_BIN" ]]; then
      echo "  build it via: (cd third_party/proving-utils && cargo +nightly-2025-07-14 build --release -p stwo-run-and-prove)" >&2
    fi
    if [[ "$f" == "$EXECUTABLE_JSON" ]]; then
      echo "  build it via: scarb --manifest-path stwo-side/cairo/Scarb.toml build" >&2
    fi
    exit 2
  fi
done

# -- build the SimpleBootloaderInput JSON ---------------------------------

BL_INPUT="$(mktemp)"
trap 'rm -f "$BL_INPUT"' EXIT

python3 - <<PYEOF > "$BL_INPUT"
import json, hashlib, sys

with open("${FIXTURE}") as f:
    fix = json.load(f)

if fix.get("version") != "v0.3-iadd":
    print(f"FIXTURE.SCHEMA_INVALID: expected a v0.3-iadd fixture, got {fix.get('version')!r}", file=sys.stderr)
    raise SystemExit(2)

cb = bytes.fromhex(fix["circuit_byte_serialisation_hex"])

# Blake2s commitment split into lo/hi u128.
# digest_to_u256_be in Cairo maps: high = bytes[0:16] BE, low = bytes[16:32] BE.
blake2s_bytes = hashlib.blake2s(cb).digest()
assert blake2s_bytes.hex() == fix["circuit_commitment_blake2s_hex"], "fixture blake2s drift"
comm_hi = int.from_bytes(blake2s_bytes[:16],  "big")
comm_lo = int.from_bytes(blake2s_bytes[16:32], "big")

n_reps = fix["repetitions"]
n_tc = len(fix["test_cases"])
n_sb = len(fix["test_cases"][0]["x_hex"]) // 2

tc_felts = []
for tc in fix["test_cases"]:
    x_bytes = bytes.fromhex(tc["x_hex"])
    y_bytes = bytes.fromhex(tc["y_hex"])
    assert len(x_bytes) == n_sb and len(y_bytes) == n_sb, "ragged test-case state widths"
    tc_felts.extend(list(x_bytes))
    tc_felts.extend(list(y_bytes))

# Flat input for iadd_executable (v0.3-iadd):
#   [n_cb, b0..b{n_cb-1}, comm_lo, comm_hi, n_reps, n_sb, n_tc, x0.., y0.., ...]
n_cb  = len(cb)
inner = [n_cb, *list(cb), comm_lo, comm_hi, n_reps, n_sb, n_tc, *tc_felts]

# Cairo Arrays serialize as [len, val0, val1, ...] for user_args_list.
user_args = [len(inner), *inner]

data = {
    "fact_topologies_path": None,
    "single_page": True,
    "tasks": [
        {
            "type": "Cairo1Executable",
            "program_hash_function": "Pedersen",
            "path": "${EXECUTABLE_JSON}",
            "user_args_list": user_args,
        }
    ],
}
print(json.dumps(data, indent=2), file=sys.stdout)
print(f"# circuit bytes: {n_cb}", file=sys.stderr)
print(f"# repetitions:   {n_reps}", file=sys.stderr)
print(f"# state bytes:   {n_sb}", file=sys.stderr)
print(f"# n_tc:          {n_tc}", file=sys.stderr)
PYEOF

mkdir -p "$(dirname -- "$PROOF_OUT")"

echo "iadd-prove: orchestrating Cairo 1 → simple-bootloader → Stwo Circle STARK"
echo "  fixture:     $FIXTURE"
echo "  executable:  $EXECUTABLE_JSON"
echo "  bootloader:  $SIMPLE_BOOTLOADER"
echo "  proof out:   $PROOF_OUT  (format: $PROOF_FORMAT)"

# -- run + prove + inline-verify -----------------------------------------

"$PROVING_UTILS_BIN" \
    --program "$SIMPLE_BOOTLOADER" \
    --program_input "$BL_INPUT" \
    --proof_path "$PROOF_OUT" \
    --proof-format "$PROOF_FORMAT" \
    --verify

echo "iadd-prove: ✅ Cairo 1 program proved + inline-verified end-to-end"
echo "iadd-prove: proof file: $(ls -la "$PROOF_OUT" | awk '{print $5, $NF}')"

# RFC-0007 §"Stdout" — one CONSTRAINTS: and one TRACE_ROWS: line. The
# semantically meaningful workload size for the repeated-addition series is
# the total executed gate count: gates-per-repetition * K.
TOTAL_GATES="$(python3 -c "
import json, struct
with open('${FIXTURE}') as f:
    fix = json.load(f)
cb = bytes.fromhex(fix['circuit_byte_serialisation_hex'])
print(struct.unpack('<I', cb[4:8])[0] * fix['repetitions'])
")"
echo "CONSTRAINTS: ${TOTAL_GATES}"
echo "TRACE_ROWS:  ${TOTAL_GATES}"
