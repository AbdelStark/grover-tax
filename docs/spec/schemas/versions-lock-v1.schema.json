{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AbdelStark/grover-tax/main/docs/spec/schemas/versions-lock-v1.schema.json",
  "title": "grover-tax versions.lock v1",
  "description": "Pinned-toolchain manifest. Schema mirrors docs/spec/03-data-model.md §'Versions lock' with V-INV-1..4. Produced by scripts/lock_versions.sh; consumed by preflight.sh and analyze.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "generator_commit",
    "rustc",
    "cargo",
    "sp1",
    "stwo",
    "cairo",
    "uv",
    "python",
    "hyperfine",
    "gnu_time",
    "host"
  ],
  "properties": {
    "schema_version": {
      "description": "Versions-lock schema version (V-INV-1). Frozen at 1 for v0.1.x.",
      "const": 1
    },
    "generated_at": {
      "description": "RFC-3339 / ISO-8601 UTC timestamp at the moment lock_versions.sh ran. Excluded from drift comparison.",
      "type": "string",
      "format": "date-time"
    },
    "generator_commit": {
      "description": "Repo SHA at the time of regeneration. Excluded from drift comparison.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rustc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "commit_hash", "host"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "commit_hash": { "type": "string", "minLength": 1 },
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "sp1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sp1up_toolchain"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sp1up_toolchain": { "type": "string", "minLength": 1 }
      }
    },
    "stwo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "remote"],
      "properties": {
        "commit": {
          "description": "40-char lowercase hex SHA of the pinned Stwo upstream commit. Sentinel 'unknown' permitted only while submodule wiring (#5) is pending.",
          "type": "string",
          "anyOf": [
            { "pattern": "^[0-9a-f]{40}$" },
            { "const": "unknown" }
          ]
        },
        "remote": { "type": "string", "format": "uri" }
      }
    },
    "cairo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "uv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": {
          "description": "sha256 of the `uv` binary at the resolved path. Drifts when the user upgrades uv outside the pin.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "description": "CPython version from `uv run python --version` (matches pyproject.toml's requires-python band).",
          "type": "string",
          "pattern": "^3\\.(12|13)\\.[0-9]+(.*)?$"
        }
      }
    },
    "hyperfine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "gnu_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "binary"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "binary": {
          "description": "Absolute path to the resolved gnu-time binary. macOS: gtime via Homebrew. Linux: /usr/bin/time.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "arch",
        "model",
        "cpu_brand",
        "cores_total",
        "ram_gb",
        "kernel"
      ],
      "properties": {
        "platform": {
          "description": "OS family. V-INV-4: only `darwin` is headline-rig canonical; `linux` is permitted in CI but tagged in RESULTS.md.",
          "type": "string",
          "enum": ["darwin", "linux"]
        },
        "arch": {
          "type": "string",
          "enum": ["aarch64", "arm64", "x86_64"]
        },
        "model": { "type": "string", "minLength": 1 },
        "cpu_brand": { "type": "string", "minLength": 1 },
        "cores_total": { "type": "integer", "minimum": 1 },
        "ram_gb": { "type": "integer", "minimum": 1 },
        "kernel": { "type": "string", "minLength": 1 }
      }
    }
  }
}
